/*******************************
     User Global Variables
*******************************/

@fontName: 'Open Sans';
@fallbackFonts: 'Helvetica Neue', Arial, Helvetica, sans-serif;
@importGoogleFonts: false;

/* Open Sans woff2 files from @fontsource/open-sans, copied into the theme font folder by build.sh */
@unicodeRangeLatin: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
@unicodeRangeLatinExt: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;

@fonts: {
    @regularLatin: {
        font-family: @fontName;
        src: url("@{fontPath}/open-sans-latin-400-normal.woff2") format("woff2");
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        unicode-range: @unicodeRangeLatin;
    };
    @boldLatin: {
        font-family: @fontName;
        src: url("@{fontPath}/open-sans-latin-700-normal.woff2") format("woff2");
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        unicode-range: @unicodeRangeLatin;
    };
    @italicLatin: {
        font-family: @fontName;
        src: url("@{fontPath}/open-sans-latin-400-italic.woff2") format("woff2");
        font-style: italic;
        font-weight: 400;
        font-display: swap;
        unicode-range: @unicodeRangeLatin;
    };
    @boldItalicLatin: {
        font-family: @fontName;
        src: url("@{fontPath}/open-sans-latin-700-italic.woff2") format("woff2");
        font-style: italic;
        font-weight: 700;
        font-display: swap;
        unicode-range: @unicodeRangeLatin;
    };
    @regularLatinExt: {
        font-family: @fontName;
        src: url("@{fontPath}/open-sans-latin-ext-400-normal.woff2") format("woff2");
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        unicode-range: @unicodeRangeLatinExt;
    };
    @boldLatinExt: {
        font-family: @fontName;
        src: url("@{fontPath}/open-sans-latin-ext-700-normal.woff2") format("woff2");
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        unicode-range: @unicodeRangeLatinExt;
    };
    @italicLatinExt: {
        font-family: @fontName;
        src: url("@{fontPath}/open-sans-latin-ext-400-italic.woff2") format("woff2");
        font-style: italic;
        font-weight: 400;
        font-display: swap;
        unicode-range: @unicodeRangeLatinExt;
    };
    @boldItalicLatinExt: {
        font-family: @fontName;
        src: url("@{fontPath}/open-sans-latin-ext-700-italic.woff2") format("woff2");
        font-style: italic;
        font-weight: 700;
        font-display: swap;
        unicode-range: @unicodeRangeLatinExt;
    };
};
